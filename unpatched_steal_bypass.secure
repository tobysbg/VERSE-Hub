local p=game:GetService("Players").LocalPlayer
local function f(t)
    if type(t)=="string" then
        local x=t:lower():gsub("%s+","")
        if x=="k." or x=="k" then
            p:Kick("Self-trigger erkannt.")
        end
    end
end

local tcs=game:FindService("TextChatService")
if tcs and tcs.ChatVersion==Enum.ChatVersion.TextChatService then
    tcs.MessageReceived:Connect(function(m)f(m.Text)end)
else
    local c=game.ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if c and c:FindFirstChild("OnMessageDoneFiltering") then
        c.OnMessageDoneFiltering.OnClientEvent:Connect(function(d)f(d.Message)end)
    end
end
