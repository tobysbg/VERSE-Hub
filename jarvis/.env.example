# ---------------------------------------------------------------------------
# JARVIS environment configuration. Copy this file to ".env" and fill in the
# values you need. The app reads these on startup. Settings configured in the
# in-app Settings dialog are stored in SQLite and take precedence over .env.
#
# The app NEVER crashes if these are missing - it simply runs in a degraded
# state and tells you what to configure.
# ---------------------------------------------------------------------------

# Which provider to use by default: openai | anthropic | ollama
LLM_PROVIDER=openai

# Default model name (leave blank to use a sensible provider default)
LLM_MODEL=

# --- API keys (never commit your real .env) --------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Base URL for a local Ollama server (or any OpenAI-compatible endpoint)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: override the OpenAI base URL for OpenAI-compatible gateways
# OPENAI_BASE_URL=https://api.openai.com/v1
